# --- Required ---
DATABASE_URL=postgres://papertrail:papertrail@localhost:807/papertrail

# OpenAI: used by Agent 2 (analysis) and embeddings. Required.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Brave Search: used by Agent 1 (discovery). Required only when running the
# pipeline with --ingest (live discovery). Free tier is sufficient.
BRAVE_API_KEY=your-brave-search-api-key

# --- Optional ---
LOG_LEVEL=info

# Where the pipeline writes generated reports (gitignored).
REPORTS_DIR=generated_reports

# Optional future discovery providers (Phase 5 hardening). Not required today;
# uncomment and set if/when you add them as fallbacks for Brave.
# EXA_API_KEY=
# TAVILY_API_KEY=
# SERPAPI_API_KEY=
